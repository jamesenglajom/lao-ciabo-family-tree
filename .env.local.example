# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Used exclusively inside src/app/admin/**/actions.js to
# create/manage auth users from the admin panel. Never import this in a
# client component or expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — used to build absolute URLs for metadata/sitemap. Set to your
# real deployed domain before going live.
NEXT_PUBLIC_SITE_URL=https://lao-ciabo-family.example

# Secret — authenticates the scheduled keep-alive ping (Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>"). Set the same value in Vercel ->
# Settings -> Environment Variables. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
